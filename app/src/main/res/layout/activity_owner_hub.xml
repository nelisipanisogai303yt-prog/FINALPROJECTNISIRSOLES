<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:orientation="vertical"
    android:padding="24dp"
    tools:context=".OwnerHubActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="24dp">

        <Button
            android:id="@+id/btnBackHub"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Back"
            android:textColor="@color/primary_red"
            android:textSize="14sp"
            android:textStyle="bold"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Owner Control Hub"
            android:textColor="@color/primary_red"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="end" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Select an administrative management task:"
        android:textColor="@color/text_muted"
        android:textSize="16sp"
        android:layout_marginBottom="28dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnManageInventory"
        style="@style/RestaurantButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Manage Food Inventory &amp; Stock"
        app:icon="@android:drawable/ic_menu_edit"
        app:iconGravity="textStart" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnViewAccounts"
        style="@style/RestaurantSecondaryButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="View Registered Admin Accounts"
        app:icon="@android:drawable/ic_menu_my_calendar"
        app:iconGravity="textStart" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnViewReceipts"
        style="@style/RestaurantSecondaryButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="View Order Receipts"
        app:icon="@android:drawable/ic_menu_agenda"
        app:iconGravity="textStart" />

</LinearLayout>
